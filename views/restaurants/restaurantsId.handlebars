{{#if restaurant}}
<div class="page">
    <button type="button" class="back-button" onclick="window.history.back()">← Back to list</button>

    <section class="restaurant-detail">
        <header class="restaurant-detail__header">
            <h1 class="restaurant-detail__name">{{restaurant.name}}</h1>

            {{#if restaurant.hasCleanStreakBadge}}
            <span class="badge badge--clean">
                🏅 Clean streak (≤ 1 violation and A grade for last 2 inspections)
            </span>
            {{/if}}
        </header>

        <dl class="restaurant-detail__info">
            <div class="stat-row">
                <dt>Borough</dt>
                <dd>{{restaurant.borough}}</dd>
            </div>

            <div class="stat-row">
                <dt>Cuisine</dt>
                <dd>{{restaurant.cuisine}}</dd>
            </div>

            <div class="stat-row">
                <dt>Latest Grade</dt>
                <dd>{{#if restaurant.latestGrade}}{{restaurant.latestGrade}}{{else}}N/A{{/if}}</dd>
            </div>

            <div class="stat-row">
                <dt>Latest Score</dt>
                <dd>{{#if restaurant.latestScore}}{{restaurant.latestScore}}{{else}}N/A{{/if}}</dd>
            </div>

            <div class="stat-row">
                <dt>Latest Inspection</dt>
                <dd>{{#if restaurant.latestInspectionDate}}{{restaurant.latestInspectionDate}}{{else}}N/A{{/if}}</dd>
            </div>
        </dl>
    </section>

    <section class="restaurant-inspections">
        <h2>Inspections</h2>
        
        <br>

        {{#if inspections.length}}
            <ul class="inspection-list">
                {{#each inspections}}
                    <li class="inspection-item">
                    {{!-- https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/details --}}
                    <details>
                        <summary class="inspection-summary">
                            <span class="inspection-label">
                                Inspection 
                            </span>
                            <span class="inspection-date">
                                {{#if this.inspectionDate}}{{this.inspectionDate}}{{else}}{{this.inspectionDate}}{{/if}}
                            </span>
                        </summary>

                        <div class="inspection-body">
                        <p>Grade:
                            {{#if this.grade}}{{this.grade}}{{else}}N/A{{/if}}
                        </p>
                        <p>Score:
                            {{#if this.score}}{{this.score}}{{else}}N/A{{/if}}
                        </p>

                        {{#if this.violations.length}}
                            <h3>Violations</h3>
                            <ul class="inspection-violations">
                            {{#each this.violations}}
                                <li class="violation-row">
                                <p class="violation-code">
                                    Code: {{this.code}}
                                </p>
                                <p class="violation-description">
                                    {{this.description}}
                                </p>
                                </li>
                            {{/each}}
                            </ul>
                        {{else}}
                            <p>No violations for this inspection.</p>
                        {{/if}}
                        </div>
                    </details>
                    </li>
                {{/each}}
            </ul>
        {{else}}
            <p>No inspections found.</p>
        {{/if}}
    </section>

    <section class="restaurant-reviews">
        <h2>Reviews</h2>

        {{#if user}}
            <button id="write-review-btn" class="write-review-btn">
            Write a Review
            </button>
            {{#if error}}
            <div class="error-message">{{error}}</div>
            {{/if}}

            <form id="review-form" method="POST" action="/restaurants/{{restaurant._id}}" enctype="multipart/form-data" class="review-form">
                <label for="rating">Rating (1–5)</label>
                <select id="rating" name="rating" required>
                    <option value="">Select a rating</option>
                    <option value="1">1 — Poor</option>
                    <option value="2">2 — Fair</option>
                    <option value="3">3 — Good</option>
                    <option value="4">4 — Very Good</option>
                    <option value="5">5 — Excellent</option>
                </select>
                <br>
                <label for="title">Title</label>
                <br>
                <input id="title" name="title" type="text" maxlength="80" required />
                <br>
                <label for="body">Review</label>
                <br>
                <textarea id="body" name="body" rows="5" maxlength="2000" required></textarea>
                <br>
                <label for="photos">Upload Photos (optional)</label>
                <br>
                <input type="file" id="photos" name="photos" accept="image/*" multiple />
                <br>
                <label for="photoDescriptions">Photo Descriptions (one per photo, in order)</label>
                <br>
                <textarea id="photoDescriptions" name="photoDescriptions" rows="3" placeholder="1. Resturant exterior 2. Picture of pizza"></textarea>
                <br>
                <button class="submit-review" type="submit">Submit Review</button>
            </form>

        {{else}}
            <p class="login-required"><a href="/login">Sign in</a> to write a review.</p>
        {{/if}}

        <div class="review-list">
            {{#if reviews.length}}
                {{#each reviews}}
                    <article class="review-card">
                        <header class="review-header">
                            <h3 class="review-title">{{this.title}}</h3>

                            <div class="review-meta">
                                <span class="review-rating">
                                    Rating: {{this.rating}}
                                </span>
                                <br>
                                <span class="review-date">
                                    {{this.createdAt}}
                                </span>
                            </div>
                        </header>

                        <p class="review-body">{{this.body}}</p>

                        {{#if this.photos.length}}
                            <div class="review-photos">
                                {{#each this.photos}}
                                <figure class="review-photo-item">
                                    <img src="{{this.url}}" alt="{{this.alt}}" class="review-photo" />
                                    <figcaption>{{this.alt}}</figcaption>
                                </figure>
                                {{/each}}
                            </div>
                        {{/if}}
                    </article>
                {{/each}}
            {{else}}
                <p>No reviews yet.</p>
            {{/if}}
        </div>
    </section>
</div>
{{else}}
    <p>Restaurant not found.</p>
{{/if}}

<script src="/public/js/review-validation.js" defer></script>