<div class="profile-container">
    <h1>My Profile</h1>
    {{#if user}}
        <div class="profile-info">
            <p><strong>Display Name:</strong> {{user.displayName}}</p>
            <p><strong>Email:</strong> {{user.email}}</p>
            <p><strong>Username:</strong> {{user.username}}</p>
            <p><strong>Member Since:</strong> {{user.createdAt}}</p>
            <p><strong>Favorite Restaurants:</strong> {{user.favorites.length}}</p>
        </div>
        <br>
        <div class="profile-actions">
            <a href="/profile/edit" class="btn-primary">Edit Profile</a>
            <br>
            <br>
            {{#if favorites.length}}
                <h2>My Favorites:</h2>
                <br>
                <ul class="favorites-list">
                    {{#each favorites}}
                        <li><a href="/restaurants/{{this._id}}" class="favorites-list">{{this.name}}</a></li>
                    {{/each}}
                </ul>
            {{else}}
                <h2>No Favorites Yet:</h2>
                <br>
                <a href="/restaurants" class="btn-primary">Find Restaurants to Favorite</a>
            {{/if}}
        </div>
    {{/if}}
    <br>
    <h2>My Reviews:</h2>
    <br>
    {{#if reviews.length}}
        <div class="reviews-list">
        {{#each reviews}}
        <div class="review-card">
             <p class="resturant-title">Restaurant: <a href="/restaurants/{{this.restaurantId}}">{{this.restaurantName}}</a></p>
            <h3>{{this.title}} — ⭐ {{this.rating}}</h3>
            <p>{{this.body}}</p>
            {{#if this.photos.length}}
                <div class="review-photos">
                    {{#each this.photos}}
                        <figure class="review-photo-item">
                            <img src="{{this.url}}" alt="{{this.alt}}" class="review-photo" />
                            <figcaption>{{this.alt}}</figcaption>
                        </figure>
                    {{/each}}
                </div>
            {{/if}}
            <br>
            <button class="delete-review-btn" data-restaurant="{{this.restaurantId}}">Delete Review</button>
        </div>
        <br>
        {{/each}}
    </div>
    {{else}}
        <p class="no-reviews">No reviews</p>
    {{/if}}

    {{#if totalPages}}
    <div class="review-pagination">
        {{#if prevPage}}
            <a href="/profile?page={{prevPage}}" class="review-pagination-btn">Previous</a>
        {{/if}}
        <span class="review-pagination-info">Page {{currPage}} of {{totalPages}}</span>
        {{#if hasNextPage}}
            <a href="/profile?page={{nextPage}}" class="review-pagination-btn">Next</a>
        {{/if}}
    </div>
    {{/if}}
</div>

<script src="/public/js/delete-reviews.js"></script>