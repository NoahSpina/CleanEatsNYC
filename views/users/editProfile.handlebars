<div class="auth-container">
    <div class="auth-box">
        <h1>Edit Profile</h1>
        {{#if error}}<div class="error-message">{{error}}</div>{{/if}}
        <form method="POST" action="/profile" id="editProfileForm">
            <div class="form-group">
                <label for="displayName">Display Name:</label>
                <input type="text" id="displayName" name="displayName" value="{{user.displayName}}" required />
                <div id="displayNameErrors" class="client-errors" style="display: none;"></div>
            </div>
            <div class="form-group">
                <label for="email">Email:</label>
                <input type="email" id="email" name="email" value="{{user.email}}" required />
                <div id="emailErrors" class="client-errors" style="display: none;"></div>
            </div>
            <button type="submit" class="btn-primary">Save Changes</button>
            <a href="/profile" class="btn-secondary">Cancel</a>
        </form>
    </div>
</div>
<script src="/public/js/profile-validation.js"></script>

