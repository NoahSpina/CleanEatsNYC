<div class="favorites-container">
    <h1>My Favorite Restaurants</h1>
    {{#if favorites.length}}
        {{#each favorites}}
            <div class="favorite-item" data-restaurant-id="{{this}}">
                <p>Restaurant ID: {{this}}</p>
                <button onclick="removeFavorite('{{this}}')">Remove</button>
            </div>
        {{/each}}
    {{else}}
        <p>You haven't favorited any restaurants yet.</p>
        <a href="/" class="btn-primary">Browse Restaurants</a>
    {{/if}}
</div>
<script>
async function removeFavorite(restaurantId) {
    if (!confirm('Remove this restaurant?')) return;
    try {
        const response = await fetch(`/favorite/${restaurantId}`, { method: 'DELETE' });
        const data = await response.json();
        if (data.success) location.reload();
        else alert('Error: ' + data.error);
    } catch (e) {
        alert('Error removing favorite');
    }
}
</script>

