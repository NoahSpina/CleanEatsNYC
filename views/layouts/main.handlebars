<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - CleanEats NYC</title>
    <link rel="stylesheet" href="/public/styles/main.css">
</head>

<body>
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="nav-brand">CleanEats NYC</a>
            <div class="nav-links">
                {{#if user}}
                <span class="nav-user">Welcome, {{user.displayName}}</span>
                <a href="/" class="nav-link">Home</a>
                <a href="/restaurants" class="nav-link">Restaurants</a>
                <a href="/analytics" class="nav-link">Analytics</a>
                <a href="/profile" class="nav-link">Profile</a>
                {{#if (eq user.role "admin")}}
                        <a href="/admin" class="nav-link">Admin</a>
                    {{/if}}
                <a href="/logout" class="nav-link">Logout</a>
                {{else}}
                <a href="/login" class="nav-link">Login</a>
                <a href="/register" class="nav-link">Register</a>
                {{/if}}
            </div>
        </div>
    </nav>

    <main class="main-content">
        {{{body}}}
    </main>

    <footer class="footer">
        <p>&copy; 2025 CleanEats NYC. All rights reserved.</p>
    </footer>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="/public/js/favorites.js"></script>
</body>

</html>