<div class="auth-container">
    <div class="auth-box">
        <h1>Login</h1>
        {{#if error}}
            <div class="error-message">{{error}}</div>
        {{/if}}
        <form method="POST" action="/login" class="auth-form" id="loginForm" novalidate>
            <div class="form-group">
                <label for="emailOrUsername">Email or Username:</label>
                <input 
                    type="text" 
                    id="emailOrUsername" 
                    name="emailOrUsername" 
                    value="{{emailOrUsername}}"
                    required 
                    placeholder="Enter your email or username"
                    autocomplete="username"
                />
                <div id="emailOrUsernameErrors" class="client-errors" style="display: none;"></div>
            </div>
            <div class="form-group">
                <label for="password">Password:</label>
                <input 
                    type="password" 
                    id="password" 
                    name="password" 
                    required 
                    placeholder="Enter your password"
                    autocomplete="current-password"
                />
                <div id="passwordErrors" class="client-errors" style="display: none;"></div>
            </div>
            <button type="submit" class="btn-primary">Login</button>
        </form>
        <p class="auth-switch">
            Don't have an account? <a href="/register">Register here</a>
        </p>
    </div>
</div>

<script src="/public/js/auth-validation.js"></script>

