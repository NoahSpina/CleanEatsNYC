<div class="admin-container">
    <h1>Restaurant Management</h1>
    <br>
    <a href="/admin" class="back-button">← Back to Admin Dashboard</a>

    <form method="GET" action="/admin/restaurants" class="admin-search-form">
        <div class="search-container">
            <label for="search">Search Restaurants:</label>
            <input type="text" name="search" id="search" placeholder="Search by restaurant name" value="{{search}}">
            <button type="submit" class="btn-primary search-button">Search</button>
            {{#if search}}<a href="/admin/restaurants" class="btn-secondary">Clear</a>{{/if}}
        </div>
    </form>

    <div class="admin-section">
        <div class="section-header">
            <h2>All Restaurants {{#if search}}(Search: "{{search}}"){{/if}} <span
                    class="results-count">({{totalRestaurants}} total)</span></h2>
            <button class="btn-primary" onclick="showAddRestaurant()">Add New Restaurant</button>
        </div>

        {{#if restaurants}}
        <nav class="pagination">
            {{#if hasPrevPage}}<a class="page-button" href="{{buildUrl prevPage search}}">&larr;
                Previous</a>{{else}}<span class="page-button disabled">&larr; Previous</span>{{/if}}
            <span class="pagination__page-info">Page {{page}} of {{totalPages}}</span>
            {{#if hasNextPage}}<a class="page-button" href="{{buildUrl nextPage search}}">Next &rarr;</a>{{else}}<span
                class="page-button disabled">Next &rarr;</span>{{/if}}
        </nav>
        {{/if}}

        <div class="table-container">
            {{#if restaurants}}
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Borough</th>
                        <th>Cuisine</th>
                        <th>Address</th>
                        <th>Latest Grade</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each restaurants}}
                    <tr data-restaurant-id="{{this._id}}">
                        <td>{{this.name}}</td>
                        <td>{{this.borough}}</td>
                        <td>{{this.cuisine}}</td>
                        <td>{{this.address.building}} {{this.address.street}}, {{this.address.zipcode}}</td>
                        <td>{{#if this.latestGrade}}{{this.latestGrade}}{{else}}N/A{{/if}}</td>
                        <td>
                            <button class="btn-edit" onclick="editRestaurant('{{this._id}}')">Edit</button>
                            <button class="btn-delete" onclick="deleteRestaurant('{{this._id}}')">Delete</button>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
            {{else}}
            <p class="no-results">{{#if search}}No restaurants found matching "{{search}}".{{else}}No restaurants
                found.{{/if}}</p>
            {{/if}}
        </div>

        {{#if restaurants}}
        <nav class="pagination">
            {{#if hasPrevPage}}<a class="page-button" href="{{buildUrl prevPage search}}">&larr;
                Previous</a>{{else}}<span class="page-button disabled">&larr; Previous</span>{{/if}}
            <span class="pagination__page-info">Page {{page}} of {{totalPages}}</span>
            {{#if hasNextPage}}<a class="page-button" href="{{buildUrl nextPage search}}">Next &rarr;</a>{{else}}<span
                class="page-button disabled">Next &rarr;</span>{{/if}}
        </nav>
        {{/if}}
    </div>
</div>

<div id="addRestaurantModal" class="modal">
    <div class="modal-content">
        <h3>Add New Restaurant</h3>
        <form id="addRestaurantForm">
            <div class="form-group">
                <label for="addName">Restaurant Name:</label>
                <input type="text" id="addName" name="name" required>
            </div>
            <div class="form-group">
                <label for="addBorough">Borough:</label>
                <select id="addBorough" name="borough" required>
                    <option value="">Select Borough</option>
                    <option value="MANHATTAN">Manhattan</option>
                    <option value="BROOKLYN">Brooklyn</option>
                    <option value="QUEENS">Queens</option>
                    <option value="BRONX">Bronx</option>
                    <option value="STATEN ISLAND">Staten Island</option>
                </select>
            </div>
            <div class="form-group">
                <label for="addCuisine">Cuisine:</label>
                <input type="text" id="addCuisine" name="cuisine" required>
            </div>
            <div class="form-group">
                <label for="addBuilding">Building:</label>
                <input type="text" id="addBuilding" name="building" required>
            </div>
            <div class="form-group">
                <label for="addStreet">Street:</label>
                <input type="text" id="addStreet" name="street" required>
            </div>
            <div class="form-group">
                <label for="addZipcode">Zipcode:</label>
                <input type="text" id="addZipcode" name="zipcode" required>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-primary">Add Restaurant</button>
                <button type="button" class="btn-cancel" onclick="closeModal()">Cancel</button>
            </div>
        </form>
    </div>
</div>

<div id="editRestaurantModal" class="modal">
    <div class="modal-content">
        <h3>Edit Restaurant</h3>
        <form id="editRestaurantForm">
            <div class="form-group">
                <label for="editName">Restaurant Name:</label>
                <input type="text" id="editName" name="name" required>
            </div>
            <div class="form-group">
                <label for="editBorough">Borough:</label>
                <select id="editBorough" name="borough" required>
                    <option value="">Select Borough</option>
                    <option value="MANHATTAN">Manhattan</option>
                    <option value="BROOKLYN">Brooklyn</option>
                    <option value="QUEENS">Queens</option>
                    <option value="BRONX">Bronx</option>
                    <option value="STATEN ISLAND">Staten Island</option>
                </select>
            </div>
            <div class="form-group">
                <label for="editCuisine">Cuisine:</label>
                <input type="text" id="editCuisine" name="cuisine" required>
            </div>
            <div class="form-group">
                <label for="editBuilding">Building:</label>
                <input type="text" id="editBuilding" name="building" required>
            </div>
            <div class="form-group">
                <label for="editStreet">Street:</label>
                <input type="text" id="editStreet" name="street" required>
            </div>
            <div class="form-group">
                <label for="editZipcode">Zipcode:</label>
                <input type="text" id="editZipcode" name="zipcode" required>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-primary">Save Changes</button>
                <button type="button" class="btn-cancel" onclick="closeModal()">Cancel</button>
            </div>
        </form>
    </div>
</div>

<script src="/public/js/admin-restaurants.js"></script>